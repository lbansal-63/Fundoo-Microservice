{

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*",

  "Smtp": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "EnableSsl": true,
    "FromName": "Fundoo"
  },

  "Auth": {
    "Authority": "http://localhost:8080/realms/fundoo",
    "Audience": "notification-api",
    "RequireHttpsMetadata": true
  },

  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "PasswordResetTopic": "fundoo.password-reset-requested",
    "UserRegisteredTopic": "fundoo.user-registered",
    "GroupId": "notification-service",
    "DeadLetterSuffix": ".dlq",
    "MaxAttempts": 3,
    "RetryDelayMs": 2000
  }

}
