{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "Jwt": {
    "Issuer": "fundoo-user-api",
    "Audience": "fundoo-clients",
    "ExpiryMinutes": 30
  },

  "TwoFactor": {
    "Issuer": "Fundoo"
  },

  "Google": {
    "ClientId": ""
  },

  "Notification": {
    "Transport": "Kafka",
    "BaseUrl": "https://localhost:7003/"
  },

  "ServiceAuth": {
    "TokenEndpoint": "http://localhost:8080/realms/fundoo/protocol/openid-connect/token",
    "ClientId": "user-service",
    "Scope": "notification.send"
  },

  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "PasswordResetTopic": "fundoo.password-reset-requested",
    "UserRegisteredTopic": "fundoo.user-registered"
  },
  "AllowedHosts": "*"
}