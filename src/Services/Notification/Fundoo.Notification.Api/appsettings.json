{
  "ConnectionStrings": {
    "NotificationDb": "Host=localhost;Port=5432;Database=fundoonotes_notification;Username=postgres;Password=postgres"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*",

  "Smtp": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "EnableSsl": true,
    "FromAddress": "no-reply@fundoo.com",
    "FromName": "Fundoo"
  },

  "Auth": {
    "Authority": "http://localhost:8080/realms/fundoo",
    "Audience": "notification-api",
    "RequireHttpsMetadata": false
  },

  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "PasswordResetTopic": "fundoo.password-reset-requested",
    "UserRegisteredTopic": "fundoo.user-registered",
    "GroupId": "notification-service",
    "DeadLetterSuffix": ".dlq",
    "MaxAttempts": 3,
    "RetryDelayMs": 2000
  },
  "Consul": {
    "Host": "localhost",
    "Port": 8500,
    "ServiceName": "notification-api",
    "ServiceAddress": "localhost",
    "ServicePort": 7003
  }

}
