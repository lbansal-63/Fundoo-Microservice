{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "ConnectionStrings": {
    "UserDb": "Host=localhost;Port=5432;Database=fundoo_user_db;Username=postgres;Password=postgres"
  },

  "Jwt": {
    "Issuer": "fundoo-user-api",
    "Audience": "fundoo-clients",
    "SigningKey": "FundooSecretKeyForJwtAuthenticationTokenGeneration2026!#$",
    "ExpiryMinutes": 30
  },

  "TwoFactor": {
    "Issuer": "Fundoo",
    "EncryptionKey": "dXBqNXJ3OHk2dDNzMWExYjJjM2Q0ZTVmNmc3aDhpOWo="
  },

  "Google": {
    "ClientId": ""
  },

  "Notification": {
    "Transport": "Kafka",
    "BaseUrl": "https://localhost:7003/"
  },

  "ServiceAuth": {
    "TokenEndpoint": "http://localhost:8080/realms/fundoo/protocol/openid-connect/token",
    "ClientId": "user-service",
    "Scope": "notification.send"
  },

  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "PasswordResetTopic": "fundoo.password-reset-requested",
    "UserRegisteredTopic": "fundoo.user-registered"
  },
  "Consul": {
    "Host": "localhost",
    "Port": 8500,
    "ServiceName": "user-api",
    "ServiceAddress": "localhost",
    "ServicePort": 7001
  },
  "AllowedHosts": "*"
}