<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      throwConfigExceptions="true">

  <targets>
    <!-- Console target: real-time dev logs -->
    <target name="console" xsi:type="ColoredConsole"
            layout="${longdate} | ${level:uppercase=true:padding=-5} | ${logger:shortName=true} | ${message} ${exception:format=tostring}" />

    <!-- File target: rotating daily logs -->
    <target name="file" xsi:type="File"
            fileName="${basedir}/logs/user-api-${shortdate}.log"
            archiveFileName="${basedir}/logs/archive/user-api-{#}.log"
            archiveEvery="Day"
            archiveNumbering="DateAndSequence"
            maxArchiveDays="7"
            layout="${longdate} | ${level:uppercase=true:padding=-5} | ${logger} | ${message} ${exception:format=tostring}" />
  </targets>

  <rules>
    <!-- Skip noisy Microsoft internals -->
    <logger name="Microsoft.*" maxlevel="Warn" final="true" />
    <logger name="System.Net.Http.*" maxlevel="Warn" final="true" />
    <logger name="*" minlevel="Information" writeTo="console,file" />
  </rules>
</nlog>
